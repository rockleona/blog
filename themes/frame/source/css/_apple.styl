// Apple mode: structural overrides on top of the base Frame styles.
// Imported last from style.styl (underscore keeps Hexo from rendering it standalone) when color_mode is 'apple'.

html
  font-size 16px
  -webkit-font-smoothing antialiased
  -moz-osx-font-smoothing grayscale
  text-rendering optimizeLegibility

body
  letter-spacing 0.01em

// no frame border, whitespace separates regions instead
.mask-border
  display none

h1, h2, h3, h4
  letter-spacing -0.01em

// HEADER: sticky translucent bar
.header
  position sticky
  top 0
  z-index 9
  border 0
  border-bottom $line-third solid var(--color-separator)
  background-color var(--color-bar)
  -webkit-backdrop-filter saturate(180%) blur(20px)
  backdrop-filter saturate(180%) blur(20px)

.header-inner
  margin 0
  min-height 52*$px

.site-brand-container a
  font-size 17*$px
  font-weight $font-weight-semibold
  letter-spacing -0.01em

.menu-item
  margin-left $margin-l-1

  a
    color var(--color-secondary-label)
    transition color .2s ease

    &:hover
      color var(--color-label)

  &:after
    display none

.menu-item-active a
  color var(--color-label)
  font-weight $font-weight-semibold

#menu-btn
  cursor pointer
  color var(--color-secondary-label)

@media (max-width: 688px)
  .header-inner .site-nav .active
    margin-top 0
    padding-bottom $margin-m-2

  .header-inner .site-nav .menu-list .menu-item
    margin-left 0
    margin-top 0
    padding $margin-m-1 0
    border-top $line-third solid var(--color-separator)

// FOOTER
.footer
  border 0
  border-top $line-third solid var(--color-separator)
  background-color var(--color-bg-secondary)
  color var(--color-tertiary-label)

  .footer-text
    margin-top $margin-l-0
    margin-bottom $margin-l-1

  a
    color var(--color-secondary-label)

    &:hover
      text-decoration underline

// LINKS: Apple blue, underline on hover instead of the drawn-line motion
.post-content a,
.post-list a,
.post-footer a,
.post-gallery-item a,
.search-result-container a
  background-image none
  padding-bottom 0
  transition color .2s ease

.post-content a
  color var(--color-link)

  &:hover
    text-decoration underline

.post-list a,
.post-footer a,
.post-gallery-item a,
.search-result-container a
  &:hover
    color var(--color-link)

// HOME PROFILE
.profile
  margin-top $margin-primary * 1.5
  align-items center

  .profile-content
    .profile-title
      font-size 48*$px
      line-height 56*$px
      letter-spacing -0.015em

    .profile-subtitle
      font-size 24*$px
      line-height 32*$px
      font-weight $font-weight-semibold
      color var(--color-secondary-label)
      margin-bottom $margin-m-2

    .profile-body
      color var(--color-secondary-label)

    .profile-link
      margin-bottom $margin-m-0

      a
        font-size 17*$px
        color var(--color-link)
        text-decoration none

        &:after
          content ' ›'

        &:hover
          text-decoration underline

  .profile-image img
    border-radius 18*$px

// POST HEAD
.post-head
  .post-date
    color var(--color-secondary-label)

  .post-img img
    border-radius 18*$px

.year-title
  color var(--color-label)

// QUOTES & RULES
blockquote
  border-left-width 3*$px
  border-left-color var(--color-separator)

  p
    color var(--color-secondary-label)

.h-line-primary, .h-line-secondary
  background-color var(--color-separator)

// TAGS: filled capsules
.tag-list
  gap $margin-m-0

.post-tag
  border 0
  margin 0
  padding 0
  border-radius 980*$px
  background-color var(--color-fill)
  transition background-color .2s ease

  a
    display block
    padding $margin-s-2 $margin-m-1
    color var(--color-secondary-label)
    font-size 13*$px
    line-height 20*$px

  &:hover
    background-color var(--color-link)

    a
      color #ffffff

.tag-cloud .post-tag a
  font-size 15*$px
  padding $margin-m-0 $margin-m-2

// PAGE HEADING (tag pages): large title with an optional eyebrow link
.page-heading
  margin-top $margin-l-2
  margin-bottom $margin-l-0

  .page-eyebrow
    display inline-block
    margin-bottom $margin-s-2
    font-size 15*$px
    font-weight $font-weight-semibold
    color var(--color-link)

    &:after
      content ' ›'

    &:hover
      text-decoration underline

  .page-title
    margin 0

// POST LIST: grouped inset list, one rounded group per year
.year-title
  margin-top $margin-l-2
  margin-bottom $margin-m-1

.post-list-group
  background-color var(--color-bg-secondary)
  border-radius 18*$px
  overflow hidden

.post-list-item
  position relative
  margin 0
  padding $margin-m-2 $margin-l-0
  align-items center
  transition background-color .2s ease

  // inset hairline between rows, like iOS grouped lists
  & + .post-list-item::before
    content ''
    position absolute
    top 0
    left $margin-l-0
    right 0
    border-top $line-third solid var(--color-separator)

  .post-title a
    color var(--color-label)

    // stretch the title link over the whole row
    &::after
      content ''
      position absolute
      inset 0

  .post-date
    font-size 15*$px
    white-space nowrap
    color var(--color-tertiary-label)

  &:hover
    background-color var(--color-fill)

    .post-title a
      color var(--color-link)

// PAGINATOR
.paginator .h-line-primary
  display none

.pagination
  justify-content center

  &:before
    display none

  .page-number
    margin 0 $margin-m-1
    color var(--color-secondary-label)

    &:after
      display none

    &:hover
      color var(--color-link)

  .current
    color var(--color-label)
    font-weight $font-weight-semibold

  .space
    margin 0 $margin-m-0
    color var(--color-tertiary-label)

// PREV / NEXT: two cards with the neighbouring post titles
.post-footer .h-line-primary
  display none

.post-nav
  margin-top 0
  gap $margin-m-1
  flex-wrap nowrap

  .prev-item, .next-item
    min-width 0
    flex 1 1 0

    // the label + title replace the arrow icons
    .icon
      display none

  .post-link
    width 100%

    a
      display block
      height 100%
      box-sizing border-box
      padding $margin-m-2 $margin-l-0
      border-radius 18*$px
      background-color var(--color-bg-secondary)
      color var(--color-tertiary-label)
      font-size 13*$px
      transition background-color .2s ease

      &:hover
        background-color var(--color-fill)
        color var(--color-tertiary-label)

        .post-nav-title
          color var(--color-link)

  .post-nav-title
    display block
    margin-top $margin-s-2
    font-size 17*$px
    line-height 24*$px
    font-weight $font-weight-semibold
    color var(--color-label)

// CODE
code
  font-size 0.88em
  padding 0.15em 0.4em
  border-radius 6*$px
  color var(--color-label)
  background-color var(--color-fill)

// .post-content prefix outranks the markdown table rules below,
// since Hexo renders line numbers as a <table> too
.post-content figure.highlight
  margin $margin-l-0 0
  padding $margin-m-2 $margin-l-0
  border-radius 12*$px
  overflow-x auto

  table, td, th
    margin 0
    border 0
    width auto

  td
    padding 0

  td span
    line-height $line-height-code

  pre, pre span
    font-family $font-family-mono
    font-size $font-size-code
    line-height $line-height-code

  td.gutter
    padding-right $margin-m-2
    background-color var(--hl-bg)
    user-select none

    span
      color var(--color-tertiary-label)

  figcaption
    margin-bottom $margin-m-0
    color var(--color-secondary-label)

// TABLES: no vertical rules, hairline rows
.post-content table
  margin $margin-l-0 0
  border 0
  font-size 15*$px

  th, td
    border 0
    border-bottom $line-third solid var(--color-separator)
    padding $margin-m-1 $margin-m-1

  th
    font-weight $font-weight-semibold
    font-variation-settings normal
    border-bottom-color var(--color-label)

  td
    font-variation-settings normal

// SOCIAL LINKS (About page): capsule buttons, icons masked to the text color
.post-content .social-links
  display flex
  flex-wrap wrap
  justify-content center
  gap $margin-m-1
  margin $margin-l-0 0 $margin-l-1

.post-content .social-link
  display inline-flex
  align-items center
  gap $margin-m-0
  min-height 44*$px
  padding 0 $margin-m-2 + $margin-s-2
  border-radius 980*$px
  background-color var(--color-fill)
  color var(--color-label)
  font-size 15*$px
  font-weight $font-weight-medium
  text-decoration none
  transition background-color .2s ease, color .2s ease

  // external-link arrow
  &::after
    content '↗'
    font-size 13*$px
    color var(--color-tertiary-label)

  &:hover
    background-color var(--color-link)
    color #ffffff
    text-decoration none

    &::after
      color rgba(255, 255, 255, 0.8)

.social-icon
  width 18*$px
  height 18*$px
  flex-shrink 0
  background-color currentColor
  -webkit-mask-image var(--icon)
  mask-image var(--icon)
  -webkit-mask-size contain
  mask-size contain
  -webkit-mask-repeat no-repeat
  mask-repeat no-repeat
  -webkit-mask-position center
  mask-position center

// IMAGES
.post-content img
  border-radius 12*$px

// SEARCH
.search-popup-window
  border 0
  border-radius 18*$px
  box-shadow 0 20*$px 60*$px rgba(0, 0, 0, 0.25)

.search-header
  border-bottom $line-third solid var(--color-separator)

@media (max-width: 688px)
  .search-popup-window
    border-radius 0

  .post-nav
    flex-direction column

@media (max-width: 688px)
  h1, .post-head .post-info .post-title
    font-size 32*$px
    line-height 40*$px

  h2
    font-size 24*$px
    line-height 32*$px

  .profile .profile-content .profile-title
    font-size 40*$px
    line-height 48*$px

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    transition none !important
    animation none !important
