<div class="post-list">
    <% var last_month = ''; %>
    <% page.posts.each(function (post) { %>

        <% var cur_month = post.date.format('YYYY-MM'); %>

        <% if(last_month !== cur_month){ %>
            <% if (last_month !== '') { %></div><% } %>
            <div class="year-title"><%- post.date.format('YYYY [年] M [月]') %></div>
            <div class="post-list-group">
        <% last_month = cur_month; } %>

        <div class="post-list-item">
            <div class="post-title">
            <a href="<%- url_for(post.path) %>">
                <% if (post.title) {%>
                    <%= post.title %>
                <% } else {%>
                    *Untitled
                <% } %>
                </a> 
            </div>
            
            <span class="post-date"><%- date(post.date, theme.date_format) %></span>
        </div>

    <% }) %>
    <% if (last_month !== '') { %></div><% } %>
    <div id="paginator">
        <%- partial('partials/paginator') %>
    </div>
</div>
